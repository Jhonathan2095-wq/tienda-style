# Railway te da esto automáticamente en la pestaña "Variables" de tu servicio Postgres
DATABASE_URL=postgresql://usuario:password@host:puerto/nombre_bd

# Clave secreta para firmar los tokens JWT (invéntala, larga y aleatoria)
JWT_SECRET=cambia_esto_por_una_clave_larga_y_aleatoria

# Credenciales de Gmail para enviar correos de recuperación de contraseña
# IMPORTANTE: no uses tu contraseña normal de Gmail, usa una "Contraseña de aplicación"
# Se genera en: https://myaccount.google.com/apppasswords
EMAIL_USER=tucorreo@gmail.com
EMAIL_PASS=tu_contrasena_de_aplicacion

# URL de tu frontend (para armar el link de recuperación de contraseña)
FRONTEND_URL=https://web-production-ca3d3.up.railway.app

# Puerto (Railway lo asigna automáticamente, no lo toques)
PORT=3000
